# Copy to conf/local/credentials.yml and conf/langfuse/credentials.yml (both
# gitignored). Kedro loads base plus one run env, so each run env needs its own
# copy. Values are read from environment variables, so no secret is written to a file.

# Any OpenAI-compatible endpoint works: set OPENAI_BASE_URL to switch provider.
openai:
  base_url: ${oc.env:OPENAI_BASE_URL, "https://api.openai.com/v1"}
  api_key: ${oc.env:OPENAI_API_KEY, ""}

db_credentials:
  con: "sqlite:///demo-db.sqlite"

# Only used with --env langfuse
langfuse_credentials:
  public_key: ${oc.env:LANGFUSE_PUBLIC_KEY, ""}
  secret_key: ${oc.env:LANGFUSE_SECRET_KEY, ""}
  host: ${oc.env:LANGFUSE_HOST, "https://cloud.langfuse.com"}
